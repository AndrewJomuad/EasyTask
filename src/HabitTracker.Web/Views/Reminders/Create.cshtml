@model HabitTracker.Web.ViewModels.ReminderFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit reminder" : "New reminder";
}

<div class="htms-page-head">
    <div>
        <h1>@(isEdit ? "Edit reminder" : "New reminder")</h1>
        <p>Choose a habit, a time and how the reminder repeats.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="HabitId" class="form-label"></label>
                        <select asp-for="HabitId" class="form-select">
                            <option value="">— Choose a habit —</option>
                            @foreach (var h in Model.AvailableHabits)
                            {
                                <option value="@h.Id" selected="@(Model.HabitId == h.Id)">@h.Name</option>
                            }
                        </select>
                        <span asp-validation-for="HabitId" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="ReminderTime" class="form-label"></label>
                            <input asp-for="ReminderTime" class="form-control" type="time" />
                            <span asp-validation-for="ReminderTime" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="RepeatType" class="form-label"></label>
                            <select asp-for="RepeatType" class="form-select">
                                <option value="0" selected="@(Model.RepeatType == RepeatType.Once)">Once</option>
                                <option value="1" selected="@(Model.RepeatType == RepeatType.Daily)">Every scheduled day</option>
                                <option value="2" selected="@(Model.RepeatType == RepeatType.Weekly)">Weekly</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input asp-for="IsEnabled" class="form-check-input" role="switch" />
                        <label asp-for="IsEnabled" class="form-check-label" style="font-size:.88rem">Reminder enabled</label>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>@(isEdit ? "Save changes" : "Create reminder")</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
