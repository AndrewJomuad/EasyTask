@model HabitTracker.Web.ViewModels.AchievementsViewModel
@{
    ViewData["Title"] = "Achievements";
}

<div class="htms-page-head">
    <div>
        <h1>Achievements</h1>
        <p>@Model.EarnedCount of @Model.TotalCount badges unlocked</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge badge-soft badge-soft-primary" style="font-size:.85rem;padding:.5em .8em">
            <i class="bi bi-gem me-1"></i>@Model.TotalPoints points
        </span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--stat-color:#1D4ED8;--stat-bg:#EFF6FF">
            <div class="stat-icon"><i class="bi bi-check2-all"></i></div>
            <div class="stat-value">@Model.TotalCompletions</div>
            <div class="stat-label">Total completions</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--stat-color:#EA580C;--stat-bg:#FFF7ED">
            <div class="stat-icon"><i class="bi bi-fire"></i></div>
            <div class="stat-value">@Model.CurrentStreak</div>
            <div class="stat-label">Current streak</div>
            <div class="stat-meta">Best: @Model.LongestStreak days</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--stat-color:#F59E0B;--stat-bg:#FFFBEB">
            <div class="stat-icon"><i class="bi bi-star"></i></div>
            <div class="stat-value">@Model.PerfectDays</div>
            <div class="stat-label">Perfect days</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--stat-color:#16A34A;--stat-bg:#F0FDF4">
            <div class="stat-icon"><i class="bi bi-list-task"></i></div>
            <div class="stat-value">@Model.ActiveHabits</div>
            <div class="stat-label">Active habits</div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-trophy text-warning"></i><span>Badges</span>
        <span class="badge badge-soft badge-soft-primary ms-auto">@Model.EarnedCount / @Model.TotalCount</span>
    </div>
    <div class="card-body">
        <div class="progress mb-3">
            <div class="progress-bar bg-warning" style="width:@(Model.TotalCount == 0 ? 0 : Model.EarnedCount * 100 / Model.TotalCount)%"></div>
        </div>

        <div class="row g-3">
            @foreach (var card in Model.Achievements)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="achievement-card @(card.Earned ? "" : "locked")">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="ach-icon" style="background:@card.Achievement.Color"><i class="bi @card.Achievement.Icon"></i></span>
                            @if (card.Earned)
                            {
                                <span class="badge badge-soft badge-soft-success"><i class="bi bi-check2 me-1"></i>Earned</span>
                            }
                            else
                            {
                                <span class="badge badge-soft badge-soft-muted"><i class="bi bi-lock me-1"></i>Locked</span>
                            }
                        </div>
                        <h3>@card.Achievement.Name</h3>
                        <p>@card.Achievement.Description</p>

                        <div class="d-flex justify-content-between mb-1" style="font-size:.72rem">
                            <span class="text-muted">@card.Progress / @card.Target @card.CriteriaLabel</span>
                            <span class="fw-semibold">@card.Percent.ToString("0")%</span>
                        </div>
                        <div class="progress progress-thin">
                            <div class="progress-bar" style="width:@card.Percent%;background:@card.Achievement.Color"></div>
                        </div>

                        @if (card.Earned && card.EarnedAt.HasValue)
                        {
                            <div class="text-muted mt-2" style="font-size:.7rem">
                                <i class="bi bi-calendar-check me-1"></i>@card.EarnedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-receipt text-primary"></i><span>Reward transactions</span></div>
    <div class="card-body p-0">
        @if (Model.Transactions.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-receipt"></i>
                <h3>No transactions yet</h3>
                <p>Complete a habit to earn your first points.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Date</th><th>Reason</th><th class="text-end">Points</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td class="text-nowrap text-muted">@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>@t.Reason</td>
                                <td class="text-end fw-semibold @(t.PointsChange >= 0 ? "text-success" : "text-danger")">
                                    @(t.PointsChange >= 0 ? "+" : "")@t.PointsChange
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
