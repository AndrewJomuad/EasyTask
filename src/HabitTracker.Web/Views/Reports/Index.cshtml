@model HabitTracker.Web.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
    var a = Model.Analytics;
}

<div class="htms-page-head">
    <div>
        <h1>Reports</h1>
        <p>@Model.From.ToString("dd MMM yyyy") — @Model.To.ToString("dd MMM yyyy") · @Model.LogCount records</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-danger" asp-action="ExportPdf"
           asp-route-range="@Model.Range" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">
            <i class="bi bi-file-earmark-pdf me-1"></i>Export PDF
        </a>
        <a class="btn btn-outline-success" asp-action="ExportExcel"
           asp-route-range="@Model.Range" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">
            <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
        </a>
        <a class="btn btn-outline-primary" asp-action="ExportCsv"
           asp-route-range="@Model.Range" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">
            <i class="bi bi-filetype-csv me-1"></i>Export CSV
        </a>
        <button class="btn btn-outline-secondary" type="button" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>
</div>

<div class="card mb-3 no-print">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label" for="rangeSelect">Range</label>
                <select class="form-select" id="rangeSelect" name="range">
                    <option value="7" selected="@(Model.Range == "7")">Last 7 days</option>
                    <option value="30" selected="@(Model.Range == "30")">Last 30 days</option>
                    <option value="90" selected="@(Model.Range == "90")">Last 90 days</option>
                    <option value="365" selected="@(Model.Range == "365")">Last 12 months</option>
                    <option value="custom" selected="@(Model.Range == "custom")">Custom</option>
                </select>
            </div>
            <div class="col-6 col-md-3" id="customRange">
                <label class="form-label" for="from">From</label>
                <input class="form-control" type="date" id="from" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-3" id="customRange2">
                <label class="form-label" for="to">To</label>
                <input class="form-control" type="date" id="to" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-arrow-repeat me-1"></i>Apply</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-2">
        <div class="stat-card" style="--stat-color:#1D4ED8;--stat-bg:#EFF6FF">
            <div class="stat-value">@a.TotalScheduled</div>
            <div class="stat-label">Scheduled</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="stat-card" style="--stat-color:#16A34A;--stat-bg:#F0FDF4">
            <div class="stat-value">@a.TotalCompleted</div>
            <div class="stat-label">Completed</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="stat-card" style="--stat-color:#F59E0B;--stat-bg:#FFFBEB">
            <div class="stat-value">@a.TotalSkipped</div>
            <div class="stat-label">Skipped</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="stat-card" style="--stat-color:#DC2626;--stat-bg:#FEF2F2">
            <div class="stat-value">@a.TotalMissed</div>
            <div class="stat-label">Missed</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="stat-card" style="--stat-color:#0EA5E9;--stat-bg:#F0F9FF">
            <div class="stat-value">@a.CompletionRate.ToString("0.#")%</div>
            <div class="stat-label">Completion</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="stat-card" style="--stat-color:#7C3AED;--stat-bg:#F5F3FF">
            <div class="stat-value">@a.PerfectDays</div>
            <div class="stat-label">Perfect days</div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><i class="bi bi-bar-chart-line text-primary"></i><span>Habit performance</span></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Habit</th><th>Category</th>
                        <th class="text-center">Scheduled</th><th class="text-center">Completed</th>
                        <th class="text-center">Skipped</th><th class="text-center">Missed</th>
                        <th class="text-center">Rate</th><th class="text-center">Best streak</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in a.HabitComparison)
                    {
                        <tr>
                            <td class="fw-semibold">@row.Name</td>
                            <td class="text-muted">@row.CategoryName</td>
                            <td class="text-center">@row.Scheduled</td>
                            <td class="text-center text-success fw-semibold">@row.Completed</td>
                            <td class="text-center text-warning">@row.Skipped</td>
                            <td class="text-center text-danger">@row.Missed</td>
                            <td class="text-center">@row.Rate.ToString("0.#")%</td>
                            <td class="text-center">@row.LongestStreak</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-journal-text text-primary"></i><span>Recorded history</span></div>
    <div class="card-body p-0">
        @if (Model.Logs.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-journal-x"></i>
                <h3>No records in this range</h3>
                <p>Choose a wider date range or start recording habits.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Date</th><th>Habit</th><th>Category</th><th>Status</th><th>Notes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td class="text-nowrap">@log.LogDate.ToString("dd MMM yyyy")</td>
                                <td>@log.Habit?.Name</td>
                                <td class="text-muted">@log.Habit?.Category?.Name</td>
                                <td>
                                    <span class="badge badge-soft @(log.Status == HabitLogStatus.Completed ? "badge-soft-success" : "badge-soft-warning")">
                                        @log.Status
                                    </span>
                                </td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(log.Notes) ? "—" : log.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
