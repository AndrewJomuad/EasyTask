@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <div style="font-size:3.5rem;color:#DC2626"><i class="bi bi-exclamation-octagon"></i></div>
    <h1 class="mt-2" style="font-size:1.4rem">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request. Please try again.</p>
    <div class="d-flex gap-2 justify-content-center mt-3">
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Go to dashboard</a>
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Home</a>
    </div>
</div>
