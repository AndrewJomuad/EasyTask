@{
    ViewData["Title"] = "Page not found";
    var code = ViewBag.Code as int? ?? 404;
    var message = ViewBag.Message as string ?? "An unexpected error occurred.";
}

<div class="text-center py-5">
    <div class="fw-bold" style="font-size:4rem;color:#CBD5E1;line-height:1">@code</div>
    <h1 class="mt-2" style="font-size:1.4rem">@message</h1>
    <p class="text-muted">The page may have moved, or the link may be incorrect.</p>
    <div class="d-flex gap-2 justify-content-center mt-3">
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Go to dashboard</a>
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Home</a>
    </div>
</div>
