@{
    Layout = null;
    ViewData["Title"] = "Habit Tracking Management System";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HTMS · Habit Tracking Management System</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="container">
    <nav class="landing-nav">
        <a asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
            <span class="htms-brand-mark" style="background:#1D4ED8;color:#fff"><i class="bi bi-check2-square"></i></span>
            <span class="htms-brand-text">
                <strong style="color:#0F172A">HTMS</strong>
                <span style="color:#64748B">Habit Tracker</span>
            </span>
        </a>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Sign in</a>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Get started</a>
        </div>
    </nav>
</div>

<section class="landing-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="landing-badge"><i class="bi bi-stars"></i> Progress analytics · Streaks · Achievements</span>
                <h1>Turn small daily actions into lasting habits.</h1>
                <p class="lead mt-3">
                    HTMS helps you plan habits by category and schedule, record daily progress,
                    monitor streaks, and understand your consistency with clear charts and exportable reports.
                </p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">
                        <i class="bi bi-person-plus me-1"></i> Create free account
                    </a>
                    <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                    </a>
                </div>
                <div class="d-flex flex-wrap gap-4 mt-4" style="font-size:.82rem;color:#64748B">
                    <span><i class="bi bi-shield-check text-success me-1"></i>Secure ASP.NET Core Identity</span>
                    <span><i class="bi bi-phone me-1"></i>Works on any device</span>
                    <span><i class="bi bi-file-earmark-arrow-down me-1"></i>PDF &amp; Excel export</span>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card" style="box-shadow:0 24px 60px rgba(15,23,42,.14)">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="text-muted" style="font-size:.75rem">TODAY'S PROGRESS</div>
                                <div class="fw-bold" style="font-size:1.5rem">4 of 5 completed</div>
                            </div>
                            <div class="htms-ring" style="--pct:80;width:72px;height:72px">
                                <span style="font-size:.85rem">80%</span>
                            </div>
                        </div>
                        <div class="progress mb-3"><div class="progress-bar bg-success" style="width:80%"></div></div>

                        <div class="habit-row is-done mb-2">
                            <span class="habit-icon" style="background:#0EA5E9"><i class="bi bi-droplet"></i></span>
                            <div class="flex-grow-1"><p class="habit-name">Drink 8 glasses of water</p>
                                <div class="habit-meta"><span class="streak-pill"><i class="bi bi-fire"></i>12 day streak</span></div></div>
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        </div>
                        <div class="habit-row is-done mb-2">
                            <span class="habit-icon" style="background:#1D4ED8"><i class="bi bi-book"></i></span>
                            <div class="flex-grow-1"><p class="habit-name">Read 20 pages</p>
                                <div class="habit-meta"><span class="streak-pill"><i class="bi bi-fire"></i>7 day streak</span></div></div>
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        </div>
                        <div class="habit-row mb-0">
                            <span class="habit-icon" style="background:#16A34A"><i class="bi bi-flower1"></i></span>
                            <div class="flex-grow-1"><p class="habit-name">Meditate 10 minutes</p>
                                <div class="habit-meta"><span class="badge badge-soft badge-soft-muted">Pending</span></div></div>
                            <i class="bi bi-circle text-muted fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 style="font-size:1.6rem">Everything you need to stay consistent</h2>
            <p class="text-muted">A complete habit system — not just a checklist.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="feature-tile">
                    <i class="bi bi-list-task"></i>
                    <h3>Habit management</h3>
                    <p>Create habits with categories, frequency, targets, date ranges and weekday schedules.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-tile">
                    <i class="bi bi-check2-circle"></i>
                    <h3>Daily tracking</h3>
                    <p>Mark habits completed or skipped with notes. Duplicate records are prevented automatically.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-tile">
                    <i class="bi bi-fire"></i>
                    <h3>Streak monitoring</h3>
                    <p>Current and longest streaks calculated from scheduled opportunities, not calendar days.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-tile">
                    <i class="bi bi-graph-up-arrow"></i>
                    <h3>Analytics</h3>
                    <p>Daily, weekly and monthly completion rates with habit and category comparisons.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-tile">
                    <i class="bi bi-calendar3"></i>
                    <h3>Calendar history</h3>
                    <p>A month view showing completed, skipped, partial and missed days at a glance.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-tile">
                    <i class="bi bi-bell"></i>
                    <h3>Reminders</h3>
                    <p>Set reminder times per habit, with suppression once the habit is already completed.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-tile">
                    <i class="bi bi-trophy"></i>
                    <h3>Achievements</h3>
                    <p>Unlock badges for streaks, completions and perfect days, with a full points ledger.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-tile">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <h3>Reports</h3>
                    <p>Export professional PDF and Excel progress reports for any date range.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="py-4 border-top" style="background:#fff">
    <div class="container d-flex flex-wrap justify-content-between gap-2" style="font-size:.82rem;color:#64748B">
        <span>&copy; @DateTime.Now.Year Habit Tracking Management System</span>
        <span>ASP.NET Core MVC · SQL Server · Entity Framework Core</span>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
