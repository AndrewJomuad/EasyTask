@model HabitTracker.Web.Models.Entities.ApplicationUser
@{
    ViewData["Title"] = "User details";
    var habits = ViewBag.Habits as List<HabitTracker.Web.Models.Entities.Habit> ?? new();
    var logs = ViewBag.Logs as List<HabitTracker.Web.Models.Entities.HabitLog> ?? new();
    var achievements = ViewBag.Achievements as List<HabitTracker.Web.Models.Entities.UserAchievement> ?? new();
    var role = ViewBag.Role as string ?? AppRoles.User;
}

<div class="htms-page-head">
    <div>
        <h1>@Model.FullName</h1>
        <p>@@@Model.UserName · @Model.Email</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--stat-color:#1D4ED8;--stat-bg:#EFF6FF">
            <div class="stat-value">@habits.Count</div><div class="stat-label">Habits</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--stat-color:#16A34A;--stat-bg:#F0FDF4">
            <div class="stat-value">@logs.Count</div><div class="stat-label">Recent records</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--stat-color:#7C3AED;--stat-bg:#F5F3FF">
            <div class="stat-value">@Model.TotalPoints</div><div class="stat-label">Points</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="--stat-color:#F59E0B;--stat-bg:#FFFBEB">
            <div class="stat-value">@achievements.Count</div><div class="stat-label">Achievements</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-person text-primary"></i><span>Account</span></div>
            <div class="card-body" style="font-size:.86rem">
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Role</span>
                    <span class="badge badge-soft @(role == AppRoles.Admin ? "badge-soft-primary" : "badge-soft-muted")">@role</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Status</span>
                    <span class="badge badge-soft @(Model.IsActive ? "badge-soft-success" : "badge-soft-danger")">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Created</span><span>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Last sign-in</span><span>@(Model.LastLoginAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Never")</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-trophy text-warning"></i><span>Achievements</span></div>
            <div class="card-body">
                @if (achievements.Count == 0)
                {
                    <p class="text-muted mb-0" style="font-size:.85rem">No achievements earned.</p>
                }
                else
                {
                    foreach (var ua in achievements)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="habit-icon" style="background:@ua.Achievement?.Color;width:30px;height:30px;flex:0 0 30px;font-size:.85rem">
                                <i class="bi @ua.Achievement?.Icon"></i>
                            </span>
                            <div>
                                <div style="font-size:.84rem;font-weight:600">@ua.Achievement?.Name</div>
                                <div class="text-muted" style="font-size:.72rem">@ua.EarnedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-list-task text-primary"></i><span>Habits</span></div>
            <div class="card-body p-0">
                @if (habits.Count == 0)
                {
                    <p class="text-muted p-3 mb-0" style="font-size:.85rem">This user has no habits.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Habit</th><th>Category</th><th>Frequency</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var h in habits)
                                {
                                    <tr>
                                        <td class="fw-semibold">@h.Name</td>
                                        <td class="text-muted">@h.Category?.Name</td>
                                        <td class="text-muted">@h.FrequencyType</td>
                                        <td>
                                            <span class="badge badge-soft @(h.IsActive ? "badge-soft-success" : "badge-soft-muted")">
                                                @(h.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-clock-history text-primary"></i><span>Recent records</span></div>
            <div class="card-body p-0">
                @if (logs.Count == 0)
                {
                    <p class="text-muted p-3 mb-0" style="font-size:.85rem">No records yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Date</th><th>Habit</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var log in logs)
                                {
                                    <tr>
                                        <td class="text-nowrap">@log.LogDate.ToString("dd MMM yyyy")</td>
                                        <td>@log.Habit?.Name</td>
                                        <td>
                                            <span class="badge badge-soft @(log.Status == HabitLogStatus.Completed ? "badge-soft-success" : "badge-soft-warning")">
                                                @log.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
