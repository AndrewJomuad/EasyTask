@model HabitTracker.Web.ViewModels.AdminSettingsViewModel
@{
    ViewData["Title"] = "System settings";
    string Val(string key) => Model.Values.TryGetValue(key, out var v) ? v : "";
}

<div class="htms-page-head">
    <div>
        <h1>System settings</h1>
        <p>Application-wide defaults applied to every account.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <form asp-action="Index" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="v_site">Application name</label>
                            <input class="form-control" id="v_site" name="values[@SettingKeys.SiteName]" value="@Val(SettingKeys.SiteName)" maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="v_points">Points per completion</label>
                            <input class="form-control" id="v_points" type="number" min="0" max="1000"
                                   name="values[@SettingKeys.PointsPerCompletion]" value="@Val(SettingKeys.PointsPerCompletion)" />
                            <div class="form-text">Points awarded each time a habit is completed.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="v_perfect">Points per perfect day</label>
                            <input class="form-control" id="v_perfect" type="number" min="0" max="1000"
                                   name="values[@SettingKeys.PointsPerPerfectDay]" value="@Val(SettingKeys.PointsPerPerfectDay)" />
                            <div class="form-text">Bonus when every scheduled habit is completed.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="v_skipped">Points for a skipped habit</label>
                            <input class="form-control" id="v_skipped" type="number" min="0" max="1000"
                                   name="values[@SettingKeys.PointsPerSkipped]" value="@Val(SettingKeys.PointsPerSkipped)" />
                            <div class="form-text">Usually 0 — skipping should not be rewarded.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="v_window">Reminder window (minutes)</label>
                            <input class="form-control" id="v_window" type="number" min="5" max="1440"
                                   name="values[@SettingKeys.ReminderWindowMinutes]" value="@Val(SettingKeys.ReminderWindowMinutes)" />
                            <div class="form-text">How long a reminder stays "due" after its time.</div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="v_reg"
                                       name="values[@SettingKeys.AllowSelfRegistration]" value="true"
                                       checked="@(Val(SettingKeys.AllowSelfRegistration).Equals("true", StringComparison.OrdinalIgnoreCase))" />
                                <label class="form-check-label" for="v_reg" style="font-size:.88rem">Allow public registration</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save settings</button>
                        <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-database text-primary"></i><span>Database</span></div>
            <div class="card-body" style="font-size:.85rem">
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Provider</span><span class="fw-semibold">@Model.DatabaseProvider</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Status</span>
                    <span class="badge badge-soft @(Model.DatabaseConnected ? "badge-soft-success" : "badge-soft-danger")">
                        @(Model.DatabaseConnected ? "Connected" : "Unavailable")
                    </span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Pending migrations</span><span class="fw-semibold">@Model.PendingMigrations</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Applied migrations</span><span class="fw-semibold">@Model.AppliedMigrations</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-shield-check text-primary"></i><span>Security posture</span></div>
            <div class="card-body" style="font-size:.84rem">
                <div class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-success"></i><span>Passwords hashed with ASP.NET Core Identity (PBKDF2)</span></div>
                <div class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-success"></i><span>CSRF protection on every state-changing form</span></div>
                <div class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-success"></i><span>Secure, HTTP-only authentication cookies</span></div>
                <div class="d-flex gap-2 mb-2"><i class="bi bi-check-circle-fill text-success"></i><span>Role-based authorization on the admin area</span></div>
                <div class="d-flex gap-2"><i class="bi bi-check-circle-fill text-success"></i><span>Per-user data isolation in every query</span></div>
            </div>
        </div>
    </div>
</div>
